<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/graphite_primary</item>
        <item name="colorPrimaryDark">@color/graphite_primary_dark</item>
        <item name="colorAccent">@color/graphite_accent</item>
        <item name="android:colorBackground">@color/graphite_surface</item>
        <item name="android:windowBackground">@color/graphite_surface</item>
        <item name="android:textColorPrimary">@color/graphite_text_primary</item>
        <item name="android:textColorSecondary">@color/graphite_text_secondary</item>
        <item name="preferenceTheme">@style/AppPreferenceThemeOverlay</item>
    </style>
    <style name="Theme.CropActivityTheme" parent="Theme.AppCompat.DayNight">
        <item name="android:statusBarColor">?android:attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>